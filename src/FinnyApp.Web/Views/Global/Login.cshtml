@{
    ViewData["Title"] = "Log in";
}

@model FinnyApp.Web.Models.ModelViews.LoginViewModel;

<div class="auth">
    <aside class="auth-aside">
        <svg class="big-coin" aria-hidden="true"><use href="#coin" /></svg>
        <h2>Welcome back</h2>
        <p>Your family's tasks, goals and Finnies are right where you left them.</p>
    </aside>

    <section class="auth-card">
        <div>
            <h1>Log in</h1>
            <p class="lede">Enter your email and password to continue.</p>
        </div>

        <form class="form" asp-controller="Global" asp-action="Login" method="post">
            <div class="field">
                <label for="Email">Email</label>
                <input asp-for="Email" type="email" class="input" autocomplete="email" required />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="field">
                <label for="Password">Password</label>
                <div class="input-wrap">
                    <input asp-for="Password" type="password" class="input" autocomplete="current-password" required />
                    <button type="button" class="reveal" data-toggle-password aria-label="Show password" aria-pressed="false">Show</button>
                </div>
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Log in</button>
        </form>

        <p class="auth-alt">New to Finny? <a href="~/Join">Create an account</a></p>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
