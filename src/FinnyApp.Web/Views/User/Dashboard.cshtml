@*
    This is for User only where they can add tasks, goals, SubUsers and manage all from it. one page only for all functions.
*@
@{
}


@model FinnyApp.Web.ViewModels.UserLoginViewModel;

<form asp-action="Login" asp-controller="User" method="post">
    <label>Email</label>
    <input type="email" asp-for="Email" />
    <br />
    <label>Password</label>
    <input type="password" asp-for="Password" />
    <button type="submit">Sign In</button>
</form>