@{
}

@model FinnyApp.Models.ModelViews.AdminViewModel;

<h1>admin</h1>
<p>Set Child</p>
<form asp-controller="Parent" asp-action="Admin" method="post">
    <label>Child Name</label>
    <input type="text" asp-for="Name" />
    <label>Child PIN</label>
    <input type="password" asp-for="PIN" maxlength="4" />
    <button type="submit">Send</button>
</form>

<br />
<p>set Task</p>
<form asp-controller="Parent" asp-action="CreateTask" method="post">
    <label>Task Title</label>
    <input type="text" asp-for="Title" />
    <label>Task Details</label>
    <input type="text" asp-for="Detail" />
    <button type="submit">Send</button>
</form>

<br />
<p>set Goal</p>
<form asp-controller="Parent" asp-action="CreateGoal" method="post">
    <label>Goal Name</label>
    <input type="text" asp-for="Title" />
    <label>Amount of Tasks to finish</label>
    <input type="number" asp-for="Amount" />
    <button type="submit">Send</button>
</form>